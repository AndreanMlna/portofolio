# ===================================================================
# .gitignore — Andrian Maulana Portfolio Website
# ===================================================================

# -------------------------------------------------------------------
# 1. Dependencies & Package Managers (JANGAN DI-PUSH)
# -------------------------------------------------------------------
node_modules/
.pnp
.pnp.js

# -------------------------------------------------------------------
# 2. Production Build Outputs & Bundles (JANGAN DI-PUSH)
# -------------------------------------------------------------------
dist/
dist-ssr/
build/
*.local

# -------------------------------------------------------------------
# 3. Local Temporary & Scratch Files (JANGAN DI-PUSH)
#    File pengujian / debugging sementara dari proses pengembangan
# -------------------------------------------------------------------
scratch/
temp/
tmp/
*.tmp
*.temp

# Backup template mentah (ukuran besar >4MB)
*.original.*
*.bak
*.backup

# -------------------------------------------------------------------
# 4. Agent & IDE Caches / Framework Temp (JANGAN DI-PUSH)
# -------------------------------------------------------------------
.agent/
.agents/
.uix/
.vite/
.turbo/
.cache/

# -------------------------------------------------------------------
# 5. Environment Variables & Secret Credentials (SANGAT KRUSIAL)
#    Mencegah kebocoran API Key / Token rahasia ke publik GitHub
# -------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# -------------------------------------------------------------------
# 6. Logs & Diagnostics (JANGAN DI-PUSH)
# -------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -------------------------------------------------------------------
# 7. Editor & IDE Settings (JANGAN DI-PUSH)
# -------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# -------------------------------------------------------------------
# 8. Operating System Metadata (JANGAN DI-PUSH)
# -------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
